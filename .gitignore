# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Web
node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# Data & large artifacts (raw sources and generated indexes are NOT committed)
data/raw/*
data/processed/*
data/index/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep
*.parquet
*.geoparquet
*.pbf
*.tif
*.tiff
# keep small experiment result images/logs tracked; ignore bulky generated shape dumps
experiments/**/shapes/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Env / secrets
.env
.env.*

# Review / packaging artifacts (rebuildable from source + scripts; not source of truth)
EarthGlyph_*_review_*.zip
*.rar

# Local scratch probes (not deliverables, rebuilt by hand)
.scratch/

# Third-party download cache for the P0-4.5 gallery: rebuildable from the URLs +
# byte ranges + sha256 recorded in dataset_manifest.json, and 38 MB of raw NDJSON
# is not the experiment's source of truth.
experiments/**/cache/

# Built gallery contours (1.2 MB of generated geometry). The frozen role labels and
# splits live in labels.json, the integrity record in dataset_manifest.json, and the
# contours regenerate from the committed builder.
experiments/**/gallery.jsonl

# Official ShapeComp MATLAB toolbox manually downloaded by the user (407 MB, weights
# included). The repo carries only a "please cite" notice, no formal redistribution
# licence, so the raw toolbox/weights stay local. The Python port in
# earthglyph/shape_benchmark/shapecomp_port.py reads it from this path; only our own
# translation code, validation results and metadata are committed.
shapeComp_17_12_2024/
# Belt and braces for the same rule: the weights and the toolbox archive must stay out
# even if someone copies them somewhere friendlier-looking. The repository's version of
# these binaries is the SHA256 manifest, not the bytes.
*.h5
shapeComp_*.zip

# A `--limit-queries` CP8 run writes its plumbing table here and nowhere else. Keeping it out of
# Git means a 1-query smoke can never be committed, read or plotted as the frozen 24-query result.
experiments/shape_perception_benchmark/checkpoint8/_smoke/

# B4 experiment-local rebuilds (reproducible from raw + script; not sources of truth)
experiments/p0_sampling_fidelity_294/index_n*/
experiments/p0_sampling_fidelity_294/processed_n*/
