  "arms": {
    "labels": [
      "E0",
      "E1",
      "E3/sample",
      "S0K1/R3",
      "S0K2/R3",
      "S0K2/R2"
    ],
    "note": "selection of six arms, all with math and parameters already frozen elsewhere. The S0K arms need the official toolbox, which is not redistributable and is read from a gitignored directory; if it is absent the run reports which arms are blocked rather than quietly dropping them."
  },
  "cell_arithmetic": {
    "n_cells_per_arm_condition": 144,
    "n_control_cells_per_arm_condition": 24,
    "n_rotated_cells_per_arm_condition": 120,
    "note": "reported as two views, never pooled. CP8-A exists because pooling the control into a rotation headline inflated pose-blind arms by 12 free perfect scores."
  },
  "conditions": {
    "correctness_check": "T0",
    "definitions": {
      "T0": "full gallery, exact target kept -- a wiring check, not the headline",
      "T1": "exact target removed",
      "T2": "exact target and rigid near-duplicates removed -- the primary condition"
    },
    "near_duplicate_rule": "E0 aligned distance below T2_THRESHOLD, as in CP7-C",
    "primary": "T2"
  },
  "content_sha256": "d8589fe8d133111afe7546632483bebb0803d76ecda409bc829353658c8755d0",
  "coverage_audit": {
    "derived_from": "the descriptors in queries[]; no query, class or angle was changed by it",
    "honest_finding": "a family whose n_meeting is below n_queries is under-covered: the label describes the design intent, the count states what the frozen draw actually supplies, and a headline for that family may only be read over the queries that pass.",
    "method": "each family's measurable_expectation restated as bounds on circularity, solidity, elongation and hull-gap runs, evaluated per query and counted per family",
    "n_queries": 24,
    "n_queries_meeting": 17,
    "per_family": {
      "curved": {
        "criteria": [
          {
            "bound": 1.0,
            "metric": "deep_gap_runs",
            "op": ">=",
            "why": "the concavity of the C or U"
          },
          {
            "bound": 0.65,
            "metric": "elongation",
            "op": "<=",
            "why": "a dominant principal axis"
          }
        ],
        "failing_stems": [
          "horseshoe-6"
        ],
        "if_short_falls_then": "a query that fails the axis bound is a ring-like outline; it still tests rotation observability, just not the 'bent' story",
        "n_meeting": 3,
        "n_queries": 4
      },
      "forked": {
        "criteria": [
          {
            "bound": 2.0,
            "metric": "deep_gap_runs",
            "op": ">=",
            "why": "more than one branch gap"
          }
        ],
        "failing_stems": [],
        "if_short_falls_then": "branch-heavy outlines are where a single principal axis stops meaning anything; fewer of them weakens the strongest argument against pose search",
        "n_meeting": 4,
        "n_queries": 4
      },
      "heart": {
        "criteria": [
          {
            "bound": 1.0,
            "metric": "deep_gap_runs",
            "op": "==",
            "why": "exactly one apical notch"
          },
          {
            "bound": 0.85,
            "metric": "solidity",
            "op": ">=",
            "why": "two lobes fill most of the hull"
          }
        ],
        "failing_stems": [],
        "if_short_falls_then": "the heart family is the only one whose label is unambiguous, so it carries the shape-specific claim",
        "n_meeting": 4,
        "n_queries": 4
      },
      "irregular_natural": {
        "criteria": [
          {
            "bound": 2.0,
            "metric": "deep_gap_runs",
            "op": ">=",
            "why": "protruding parts make several separate gaps"
          },
          {
            "bound": 0.8,
            "metric": "elongation",
            "op": "<=",
            "why": "not a disc"
          }
        ],
        "failing_stems": [],
        "if_short_falls_then": "these are the closest thing to a real silhouette, so a shortfall here is a shortfall in the most transfer-relevant family",
        "n_meeting": 4,
        "n_queries": 4
      },
      "near_circle": {
        "criteria": [
          {
            "bound": 0.7,
            "metric": "circularity",
            "op": ">=",
            "why": "a near-disc boundary"
          },
          {
            "bound": 0.8,
            "metric": "elongation",
            "op": ">=",
            "why": "isotropic, so rotation is nearly unobservable"
          }
        ],
        "failing_stems": [
          "HCircle-8",
          "watch-11",
          "device2-6",
          "apple-14"
        ],
        "if_short_falls_then": "the isotropic case is the one place a rotation wrapper should be provably worthless; if these queries are not isotropic the study cannot make that claim, only measure the roundish ones that survive",
        "n_meeting": 0,
        "n_queries": 4
      },
      "pointed": {
        "criteria": [
          {
            "bound": 0.85,
            "metric": "solidity",
            "op": "<=",
            "why": "deep corners remove area from the hull"
          },
          {
            "bound": 1.0,
            "metric": "deep_gap_runs",
            "op": ">=",
            "why": "at least one excursion away from the hull"
          }
        ],
        "failing_stems": [
          "crown-2",
          "pencil-6"
        ],
        "if_short_falls_then": "a cornered-shape conclusion rests on the queries that pass; a smooth one in the pool is an ellipse-with-a-lid case, not a pointed case",
        "n_meeting": 2,
        "n_queries": 4
      }
    },
