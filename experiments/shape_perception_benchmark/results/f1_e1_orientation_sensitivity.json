  "mechanism_attribution": {
    "isotropic_fallback": {
      "probes": [
        "circle",
        "hexagon",
        "near_circle",
        "square",
        "star5"
      ],
      "documented_in_policy": true,
      "worst_all_drift": 0.024216196706149447,
      "mechanism": "no axis exists to align to, so the 42-column tangent block is measured against static bin edges in the drawing's own frame and is not rotation invariant"
    },
    "degenerate_eigenvector_fallback": {
      "probes": [
        "ellipse",
        "elongated",
        "heart",
        "teardrop",
        "two_lobed"
      ],
      "documented_in_policy": false,
      "worst_axis_gap_deg": 90.0,
      "mechanism": "principal_frame builds the major eigenvector as (top - cov[1,1], cov[0,1]) and falls back to +x when that pair underflows. The pair underflows exactly when the covariance is diagonal AND the larger variance sits on y, so the delivered frame is 90 degrees away from the shape's own major axis while the status still reads 'canonical'. The status word does not mean the axis was found.",
      "mean_drift_at_affected_poses": 0.011383400111806951
    },
    "sign_coin_toss_on_a_correct_axis": {
      "probes": [
        "circle",
        "ellipse",
        "hexagon",
        "near_circle",
        "square",
        "star5",
        "two_lobed"
      ],
      "documented_in_policy": true,
      "mean_drift_at_affected_poses": 0.00022673945808398044,
      "mechanism": "both third moments vanish, so FLIP_TIE_TOLERANCE=1e-9 is compared against floating-point residue and the 180-degree sign is decided by noise. The tangent bins span 0..2pi, so a flip permutes them by half a turn - but on a genuinely centrosymmetric contour the tangent multiset is itself symmetric, which is why the measured drift on those poses stays far below the drift of a pose that lost the axis. That contrast is this row's evidence: the sign is unstable, the cost is not."
    }
  },
