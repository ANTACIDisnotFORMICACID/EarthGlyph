  "selection_rules": {
    "round_lake": [
      "max exterior compactness; area >= 2 ha, solidity >= 0.90, aspect <= 1.4, hull compactness >= 0.80",
      "relaxed: dropped the hull-compactness test",
      "fallback: area >= 0.5 ha"
    ],
    "crescent": [
      "min solidity; one dominant hull deficit on a disc-like hull",
      "relaxed: dropped the disc-like-hull test",
      "fallback: single dominant deficit"
    ],
    "slender": [
      "max aspect ratio; area >= 1 ha",
      "fallback: area >= 0.2 ha"
    ],
    "dendritic_reservoir": [
      "min compactness among reservoirs; area >= 50 ha",
      "relaxed: reservoir of any area",
      "fallback: min compactness over all candidates"
    ],
    "deep_concave": [
      "min solidity; area >= 5 ha",
      "fallback: area >= 1 ha"
    ],
    "multi_bay": [
      "most convex-hull deficits (>= 4); area >= 10 ha",
      "relaxed: >= 3 deficits, area >= 2 ha",
      "fallback: area >= 1 ha"
    ]
  },
